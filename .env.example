# Cloudflare R2 credentials — only needed for real uploads.
# Until R2 is set up, run the pipeline fully locally with:  npm run ingest -- --local
#
# Where to find these (Cloudflare dashboard):
#   R2_ACCOUNT_ID        -> dashboard URL or R2 overview page (32-char hex id)
#   R2_ACCESS_KEY_ID     -> R2 > Manage R2 API Tokens > Create API Token (Object Read & Write)
#   R2_SECRET_ACCESS_KEY -> shown once when the token is created
#   R2_BUCKET            -> the bucket name you created
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=photography-portfolio

# Public base URL that serves the bucket (no trailing slash).
# Custom domain recommended; the free *.r2.dev URL works to start but is rate-limited.
PUBLIC_IMAGE_BASE_URL=https://images.example.com

# Print requests (npm run requests) — optional. Create a SECOND R2 API token with
# Object Read & Write scoped to ONLY the print-requests bucket, so the photo-upload
# token above never needs access to visitor names/emails. If unset, the main
# credentials are used (and must have access to the print-requests bucket).
PRINT_REQUESTS_BUCKET=print-requests
PRINT_REQUESTS_ACCESS_KEY_ID=
PRINT_REQUESTS_SECRET_ACCESS_KEY=
