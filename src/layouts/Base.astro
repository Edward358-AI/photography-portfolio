---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';
import { SITE } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string | undefined;
}

const { title, description = SITE.description, ogImage } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageAbs = ogImage ? new URL(ogImage, Astro.site).href : undefined;
const path = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => path.startsWith(href.replace(/\/$/, ''));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImageAbs && <meta property="og:image" content={ogImageAbs} />}
    <meta name="twitter:card" content={ogImageAbs ? 'summary_large_image' : 'summary'} />
  </head>
  <body class="min-h-dvh flex flex-col bg-base text-fg">
    <header class="sticky top-0 z-40 border-b border-line/70 bg-base/85 backdrop-blur">
      <div class="mx-auto flex h-14 w-full max-w-7xl items-center justify-between px-4 sm:px-6">
        <a href="/" class="font-display text-[0.95rem] font-semibold tracking-wide hover:text-accent transition-colors">
          {SITE.name}
        </a>
        <nav class="flex items-center gap-1 text-sm" aria-label="Main">
          {
            SITE.nav.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'rounded-md px-3 py-1.5 transition-colors hover:text-fg',
                  isActive(item.href) ? 'text-fg bg-raised' : 'text-muted',
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-8 sm:px-6 sm:py-10">
      <slot />
    </main>

    <footer class="border-t border-line/70">
      <div
        class="mx-auto flex w-full max-w-7xl flex-wrap items-center justify-between gap-3 px-4 py-6 text-xs text-faint sm:px-6"
      >
        <p>© {new Date().getFullYear()} {SITE.name}. All photographs are the author's.</p>
        <div class="flex gap-4">
          {
            SITE.socials.map((s) => (
              <a href={s.href} class="hover:text-muted transition-colors" rel="me noopener" target="_blank">
                {s.label}
              </a>
            ))
          }
        </div>
      </div>
    </footer>
  </body>
</html>
