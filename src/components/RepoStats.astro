---
/**
 * GitHub repo statistics, fetched once at build time (no client JS, refreshes
 * on every deploy). Renders nothing if the API is unreachable or rate-limited,
 * so builds never fail because of it.
 */
interface Props {
  githubUrl?: string | undefined;
}

const { githubUrl } = Astro.props;

let stats: { stars: number; forks: number; language: string | null } | null = null;
const m = githubUrl?.match(/github\.com\/([^/]+)\/([^/#?]+)/);
if (m) {
  try {
    const res = await fetch(`https://api.github.com/repos/${m[1]}/${m[2]}`, {
      signal: AbortSignal.timeout(6000),
      headers: { Accept: 'application/vnd.github+json', 'User-Agent': 'astro-portfolio-build' },
    });
    if (res.ok) {
      const j = await res.json();
      stats = { stars: j.stargazers_count ?? 0, forks: j.forks_count ?? 0, language: j.language ?? null };
    }
  } catch {
    /* offline or rate-limited build — omit stats */
  }
}
---

{
  stats && (
    <div class="flex items-center gap-4 text-xs text-faint" title="Live from GitHub at build time">
      <span class="flex items-center gap-1">
        <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z" />
        </svg>
        {stats.stars}
      </span>
      <span class="flex items-center gap-1">
        <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z" />
        </svg>
        {stats.forks}
      </span>
      {stats.language && <span>{stats.language}</span>}
    </div>
  )
}
