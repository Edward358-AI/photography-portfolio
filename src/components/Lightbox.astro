---
import type { CollectionEntry } from 'astro:content';

interface Props {
  photos: CollectionEntry<'photos'>[];
}

const { photos } = Astro.props;

const payload = photos.map((p) => ({
  id: p.id,
  title: p.data.title,
  alt: p.data.alt,
  location: p.data.location ?? null,
  date: p.data.date.toISOString(),
  exif: p.data.exif ?? null,
  w: p.data.image.width,
  h: p.data.image.height,
  variants: p.data.image.variants,
}));
// `<` escaped so titles can never break out of the JSON script block
const json = JSON.stringify(payload).replace(/</g, '\\u003c');
---

<dialog class="lightbox" id="lightbox" aria-label="Photo viewer">
  <div class="lb-stage" data-lb-stage>
    <button class="lb-btn lb-close" data-lb-close aria-label="Close (Esc)">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
    <button class="lb-btn lb-prev" data-lb-prev aria-label="Previous photo (←)">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7" /></svg>
    </button>
    <button class="lb-btn lb-next" data-lb-next aria-label="Next photo (→)">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7" /></svg>
    </button>
    <div class="lb-frame" data-lb-frame></div>
  </div>
  <div class="lb-meta">
    <span class="lb-title" data-lb-title></span>
    <span data-lb-sub></span>
    <span class="lb-exif" data-lb-exif></span>
    <span class="lb-counter" data-lb-counter></span>
  </div>
</dialog>
<script type="application/json" id="lightbox-data" set:html={json} />
<script>
  import '../scripts/lightbox';
</script>
