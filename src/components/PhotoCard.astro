---
import type { CollectionEntry } from 'astro:content';

interface Props {
  photo: CollectionEntry<'photos'>;
  /** Above-the-fold cards load eagerly with high fetch priority (LCP). */
  eager?: boolean;
}

const { photo, eager = false } = Astro.props;
const d = photo.data;
const ratio = d.image.width / d.image.height;
const avifSrcset = d.image.variants.map((v) => `${v.avif} ${v.width}w`).join(', ');
const webpSrcset = d.image.variants.map((v) => `${v.webp} ${v.width}w`).join(', ');
const fallback = (d.image.variants.find((v) => v.width >= 1080) ?? d.image.variants[d.image.variants.length - 1]).webp;
const sizes = '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw';

const gear = [d.exif?.camera, d.exif?.lens].filter(Boolean).join(' · ');
const settings = [
  d.exif?.focalLength,
  d.exif?.aperture,
  d.exif?.shutterSpeed,
  d.exif?.iso != null ? `ISO ${d.exif.iso}` : undefined,
]
  .filter(Boolean)
  .join(' · ');
---

<figure class="card" style={`--r:${ratio.toFixed(4)}`} tabindex="0">
  <div class="ph" style={`background-image:url("${d.image.lqip}")`}>
    <picture>
      <source type="image/avif" srcset={avifSrcset} sizes={sizes} />
      <img
        src={fallback}
        srcset={webpSrcset}
        sizes={sizes}
        width={d.image.width}
        height={d.image.height}
        alt={d.alt}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={eager ? 'high' : 'auto'}
      />
    </picture>
  </div>
  <figcaption class="card-overlay">
    <span class="ov-title">{d.title}</span>
    {gear && <span class="ov-meta">{gear}</span>}
    {settings && <span class="ov-meta">{settings}</span>}
  </figcaption>
</figure>
