---
import { getCollection } from 'astro:content';
import CategoryTabs from '../../components/CategoryTabs.astro';
import Gallery from '../../components/Gallery.astro';
import Base from '../../layouts/Base.astro';

const photos = (await getCollection('photos')).sort((a, b) => +b.data.date - +a.data.date);
const og = photos[0]?.data.image.variants.find((v) => v.width >= 1080)?.webp;
---

<Base title="Photos" description="All photographs — aviation, landscape, cityscape and nature." ogImage={og}>
  <h1 class="mb-6 font-display text-2xl font-semibold tracking-tight">Photos</h1>
  <CategoryTabs />
  <Gallery photos={photos} eagerCount={6} />
</Base>
