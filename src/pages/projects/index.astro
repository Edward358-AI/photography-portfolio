---
import { getCollection } from 'astro:content';
import ProjectCard from '../../components/ProjectCard.astro';
import Base from '../../layouts/Base.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.featuredOrder - b.data.featuredOrder);
---

<Base title="Projects" description="Software projects and technical write-ups.">
  <h1 class="mb-6 font-display text-2xl font-semibold tracking-tight">Projects</h1>
  {
    projects.length === 0 ? (
      <p class="py-16 text-center text-muted">No write-ups yet.</p>
    ) : (
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((p) => (
          <ProjectCard project={p} />
        ))}
      </div>
    )
  }
</Base>
