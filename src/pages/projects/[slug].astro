---
import { getCollection, render } from 'astro:content';
import RepoStats from '../../components/RepoStats.astro';
import TechBadge from '../../components/TechBadge.astro';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);
---

<Base title={d.title} description={d.description}>
  <article class="mx-auto max-w-3xl">
    <header class="mb-9 border-b border-line pb-7">
      <a href="/projects/" class="text-sm text-faint transition-colors hover:text-muted">← Projects</a>
      <h1 class="mt-3 font-display text-3xl font-semibold tracking-tight">{d.title}</h1>
      <p class="mt-3 text-muted">{d.description}</p>
      <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3">
        <div class="flex flex-wrap gap-1.5">
          {d.techStack.map((t) => <TechBadge name={t} />)}
        </div>
        <RepoStats githubUrl={d.githubUrl} />
      </div>
      <div class="mt-5 flex gap-3 text-sm">
        {
          d.githubUrl && (
            <a href={d.githubUrl} target="_blank" rel="noopener" class="text-accent underline underline-offset-4 hover:opacity-85">
              GitHub
            </a>
          )
        }
        {
          d.liveUrl && (
            <a href={d.liveUrl} target="_blank" rel="noopener" class="text-accent underline underline-offset-4 hover:opacity-85">
              Live site
            </a>
          )
        }
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
