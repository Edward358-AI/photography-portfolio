---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="Page not found.">
  <div class="flex flex-col items-center gap-4 py-24 text-center">
    <p class="font-display text-6xl font-semibold text-faint">404</p>
    <p class="text-muted">That frame doesn't exist.</p>
    <a href="/" class="mt-2 rounded-lg border border-line px-4 py-2 text-sm text-muted transition-colors hover:border-faint hover:text-fg">
      Back home
    </a>
  </div>
</Base>
