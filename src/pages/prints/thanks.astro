---
import Base from '../../layouts/Base.astro';
---

<!-- NOTE: placeholder copy — Edward rewrites in his own voice. -->
<Base title="Request sent" description="Print request received.">
  <div class="flex flex-col items-center gap-4 py-24 text-center">
    <p class="font-display text-3xl font-semibold">Request sent</p>
    <p class="max-w-md text-muted">
      Thanks! I'll get back to you by email — usually within a few days — to confirm the
      details and send over the files.
    </p>
    <a
      href="/photos/"
      class="mt-2 rounded-lg border border-line px-4 py-2 text-sm text-muted transition-colors hover:border-faint hover:text-fg"
    >
      Back to the photos
    </a>
  </div>
</Base>
